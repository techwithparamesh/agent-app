# Example .env file
# Add your real API keys and secrets here (never commit this file to git)

# Session & Encryption (REQUIRED - do not change after going live)
SESSION_SECRET=
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=mysql://Reddy:Naga%40321@localhost:3306/agents_ai

# 360Dialog BSP Integration
DIALOG360_PARTNER_ID=your_partner_id
DIALOG360_API_KEY=your_api_key
DIALOG360_API_URL=https://waba.360dialog.io

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Application URL (for callbacks)
APP_URL=https://digitalagency4us.cloud

# Email (SMTP) - required for email verification + password resets
# For Gmail: enable 2FA and create an App Password; use that as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=digitalagent4us@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="DigitalAgency4us <digitalagent4us@gmail.com>"

# Alternative single-URL format (leave commented unless you prefer it)
# SMTP_URL=smtps://SMTP_USER:SMTP_PASS@smtp.gmail.com:465

# Widget security (recommended for production)
# Enforce origin checks: missing/unauthorized Origin -> 403
WIDGET_ORIGIN_ENFORCED=true
