# Example .env file
# Add your real API keys and secrets here (never commit this file to git)

# Session & Encryption (REQUIRED - do not change after going live)
SESSION_SECRET=
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=mysql://Reddy:Naga%40321@localhost:3306/agents_ai

# ========== WhatsApp Cloud API (Direct Meta Integration) ==========
# Get these from Meta Developer Portal: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_OAUTH_CALLBACK_URL=https://digitalagency4us.cloud/api/whatsapp-cloud/oauth/callback
META_GRAPH_API_VERSION=v18.0

# WhatsApp Webhook Security (recommended for production)
# When true, reject webhook POSTs with invalid/missing signatures.
WHATSAPP_WEBHOOK_ENFORCE_SIGNATURE=true
# HMAC secret used to verify X-Hub-Signature-256 (set this to your WhatsApp app secret / webhook secret)
WHATSAPP_WEBHOOK_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Application URL (for callbacks)
APP_URL=https://digitalagency4us.cloud

# Email (SMTP) - required for email verification + password resets
# For Gmail: enable 2FA and create an App Password; use that as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=digitalagent4us@gmail.com
SMTP_PASS=
SMTP_FROM="DigitalAgency4us <digitalagent4us@gmail.com>"

# Alternative single-URL format (leave commented unless you prefer it)
# SMTP_URL=smtps://SMTP_USER:SMTP_PASS@smtp.gmail.com:465

# Widget security (recommended for production)
# Enforce origin checks: missing/unauthorized Origin -> 403
WIDGET_ORIGIN_ENFORCED=true

# Server runtime
NODE_ENV=production
APP_ENV=production
VERCEL_ENV=
PORT=5008

# Redis (REQUIRED in production for WhatsApp Cloud + idempotency/rate limiting)
REDIS_URL=redis://:Sadhu%23Paramesh369@127.0.0.1:6379/0

# Additional encryption (recommended)
CREDENTIAL_ENCRYPTION_KEY=

# ========== WhatsApp Cloud / Webhooks (additional settings) ==========
# Webhook verify token used for GET challenge (set a stable value)
WHATSAPP_VERIFY_TOKEN=
# Cloud embedded signup verify token (set a stable value)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional (defaults to v18.0)
WHATSAPP_API_VERSION=v18.0

# Policy / admin controls (optional)
WHATSAPP_POLICY_DB=true
WHATSAPP_KILL_SWITCH_GLOBAL=false
# Comma-separated list of admin emails (used to protect admin endpoints in production)
WHATSAPP_ADMIN_EMAILS=
WHATSAPP_BROADCAST_MAX_RECIPIENTS=100

# ========== AI / LLM settings (optional) ==========
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# ========== Google OAuth (optional integrations) ==========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ========== Scanner / crawling (optional) ==========
SCANNER_MAX_PAGES=100
SCANNER_TIMEOUT=30000
SCANNER_USER_AGENT=Mozilla/5.0 (compatible; AgentForgeBot/1.0)
CHROME_PATH=
SCAN_COOLDOWN_SECONDS=60

# ========== Rate limiting (optional) ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
SIGNUP_RATE_LIMIT_MAX=

WORKFLOW_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WORKFLOW_WEBHOOK_RATE_LIMIT_MAX=120

# ========== Workflow code executor (optional; risky in prod) ==========
ALLOW_WORKFLOW_CODE_EXECUTOR=false

# ========== Outbound URL security (optional) ==========
OUTBOUND_URL_ALLOW_PRIVATE=false

# ========== Widget (additional settings) ==========
WIDGET_RATE_LIMIT_WINDOW_MS=60000
WIDGET_RATE_LIMIT_MAX=30
WIDGET_KEY_ENFORCED=false
WIDGET_ALLOWED_ORIGINS=
WIDGET_USAGE_MODE=cost

# ========== Replit Auth (optional; only if you use Replit OIDC) ==========
ISSUER_URL=https://replit.com/oidc
REPL_ID=
